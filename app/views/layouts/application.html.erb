<!DOCTYPE html>
<html>
  <head>
    <title>HelpMyNet</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= action_cable_meta_tag %>

    <script src='https://api.tiles.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.js'></script>
    <link href='https://api.tiles.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.css' rel='stylesheet' />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/slim-select/1.27.1/slimselect.min.css" rel="stylesheet">
  </head>

  <body>
    <div class="app-shell">
      <aside class="server-rail" aria-label="Workspace">
        <%= link_to root_path, class: "server-pill", title: "Help My Net" do %>
          HM
        <% end %>
      </aside>

      <aside class="channel-sidebar" aria-label="Primary navigation">
        <div class="workspace-header">
          <strong>Help My Net</strong>
          <span>Operations</span>
        </div>

        <nav class="channel-nav">
          <span class="nav-section">Channels</span>
          <% if user_signed_in? %>
            <% navigation_items = [
              ["Dashboard", root_path, current_page?(root_path)],
              ["Tasks", tasks_path, controller_name == "tasks"],
              ["Users", users_path, controller_name == "users"],
              ["Employees", employees_path, controller_name == "employees"],
              ["Companies", companies_path, controller_name == "companies"]
            ] %>

            <% navigation_items.each do |label, path, active| %>
              <%= link_to path, class: "channel-link #{'is-active' if active}" do %>
                <span>#</span> <%= label %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "channel-link #{'is-active' if controller_name == 'sessions'}" do %>
              <span>#</span> Sign in
            <% end %>

            <% ["Dashboard", "Tasks", "Users", "Employees", "Companies"].each do |label| %>
              <span class="channel-link channel-link-disabled">
                <span>#</span> <%= label %>
              </span>
            <% end %>
          <% end %>
        </nav>

        <% if user_signed_in? %>
          <div class="account-panel">
            <div>
              <strong><%= current_user.try(:name).presence || current_user.email %></strong>
              <span>Signed in</span>
            </div>
            <div class="account-actions">
              <%= link_to "Account", edit_account_registration_path %>
              <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete } %>
            </div>
          </div>
        <% end %>
      </aside>

      <main class="content-panel">
        <% if notice.present? %>
          <p class="flash flash-notice"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="flash flash-alert"><%= alert %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
